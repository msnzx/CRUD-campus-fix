# Copy to .env and fill in. .env is gitignored — never commit real keys.

# ---------------------------------------------------------------------------
# Frontend (React + Vite)
# Only VITE_-prefixed vars reach the browser. Never put a secret behind one.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://uatppdlslsrsfleoullv.supabase.co

# Publishable key. Safe to ship to the browser: it carries no privileges of
# its own and every request it makes is still subject to RLS.
# Prefer this over the legacy anon key — it rotates independently.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_GC2sZz6h0iRtC9AmD5dWcA_3ingtHks

# ---------------------------------------------------------------------------
# Backend (FastAPI)
# ---------------------------------------------------------------------------
SUPABASE_URL=https://uatppdlslsrsfleoullv.supabase.co

# SERVICE ROLE KEY — treat as root. It BYPASSES ROW LEVEL SECURITY entirely.
# Get it from: Dashboard > Project Settings > API > service_role
# Backend only. Never send it to the browser, never commit it, never put it
# behind a VITE_ prefix. Every endpoint using it must re-check authorization
# in Python, because the database will no longer do it for you.
SUPABASE_SERVICE_ROLE_KEY=

# AI classification provider
ANTHROPIC_API_KEY=
AI_CONFIDENCE_THRESHOLD=0.75

# Reopen window, in days. Referenced by product-spec.md section 12.
REOPEN_WINDOW_DAYS=7
