# Backend environment. Copy to .env:
#   cp .env.example .env
#
# Everything here is server-side only. None of it is ever sent to a browser.

SUPABASE_URL=https://your-project-ref.supabase.co

# Used to verify the JWT on incoming requests, and to read reference data.
# Same publishable key the frontend uses; no privileges of its own.
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# ---------------------------------------------------------------------------
# SERVICE ROLE KEY — TREAT AS ROOT.
#
# This key BYPASSES ROW LEVEL SECURITY COMPLETELY. Holding it is equivalent to
# being the database owner. Every endpoint that uses it must re-check
# authorization in Python, because the database will no longer do it for you.
#
# Get it from: Supabase Dashboard > Project Settings > API > service_role
# Never commit it. Never send it to the browser. Never prefix it with VITE_.
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=

# Local DeepSeek classification and separate writing enrichment.
# Start Ollama and pull deepseek-r1:8b first. Both steps share these settings.
# Set false to disable classification; ticket creation remains available.
AI_CLASSIFICATION_ENABLED=true
OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=deepseek-r1:8b
OLLAMA_TIMEOUT_SECONDS=180

# Routing compatibility flag: successful decisions use 1.0; review uses 0.0.
# These values are not calibrated probabilities. Explicit NEEDS_REVIEW always
# prevents automatic routing, even if this threshold is 0.
AI_CONFIDENCE_THRESHOLD=0.75

# Comma-separated origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173

# Email delivery of notifications. Leave SMTP_HOST blank to disable email;
# in-app notifications work either way. Any SMTP provider works (Resend,
# SendGrid, Gmail app password, Caldwell's relay). Uses STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=CampusFix <no-reply@caldwell.edu>
NOTIFY_INTERVAL_SECONDS=60

# Used to build the ticket link in notification emails.
APP_URL=http://localhost:5173
